<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<!-- header -->
<header>
    <nav>
        <!-- admin check -->
        {{#if isAdmin}}
            <a href="/" id="logo">Delivery Admin</a>
            <a href="/admin/bestellungen" id="adm">Alle Bestellungen</a>
        {{else}}
            <a href="/" id="logo">Delivery</a>
        {{/if}}

        <!-- login check -->
        {{#if loggedIn}}
            <a href="/produkte?category=pizza" id="menu_nav" data-locked="{{#unless loggedIn}}true{{/unless}}">Speisekarte</a>
            <a href="/ausloggen" id="ausloggen">Ausloggen</a>
            <span id="hello_user">Hello {{user.firstname}}</span>
        {{else}}
            <a href="/registrieren" id="registrieren">Registrieren</a>
            <a href="/einloggen" id="einloggen">Einloggen</a>
            <a href="/produkte?category=pizza" id="menu_nav" data-locked="{{#unless loggedIn}}true{{/unless}}">Speisekarte</a>
        {{/if}}
    </nav>
    <!-- errors-->
    <div id="toast_msg"></div>
</header>

<section id="main_part">
    <!-- description -->
    <section id="about_us">
        <img id="about_image" src="/img/home-background.png" alt="Pizza" />

        <section id="about_text">
            <p>Willkommen bei Delivery!</p>

            <p>
                Du hast gerade den kulinarischen Himmel betreten, wo der Duft von frisch
                gebackener Pizza in der Luft liegt und der Geschmack von
                unwiderstehlichem Käse auf deiner Zunge schmilzt. Hier erwartet dich
                eine einzigartige Auswahl an köstlichen Pizzas, die mit Liebe und
                Sorgfalt zubereitet werden, um deinen Gaumen zu verzaubern.
            </p>

            <p>
                &#x1F33F; Unser Geheimnis? Wir verwenden nur die frischesten und hochwertigsten
                Zutaten, um sicherzustellen, dass jede Pizza ein Meisterwerk ist. Von der
                klassischen Margherita bis hin zu kreativen Spezialitäten, bieten wir eine
                breite Palette von Geschmacksrichtungen, die jeden Hunger stillen.
            </p>

            <p>
                &#x1F3E0; Keine Lust, das Haus zu verlassen? Kein Problem! Unser zuverlässiger
                Lieferservice bringt die Pizza deiner Träume direkt zu dir nach Hause. Und das
                Beste daran? Unser Team ist für seine blitzschnelle Lieferung bekannt, sodass du
                nicht lange auf den Genuss warten musst.
            </p>

            <p>
                &#x1F4B0; Aber das ist noch nicht alles! Unsere unschlagbaren Angebote und regelmäßigen
                Aktionen sorgen dafür, dass du nicht nur deinen Gaumen, sondern auch deinen
                Geldbeutel verwöhnst. Bei uns bekommst du die beste Qualität zum besten Preis!
            </p>

            <p>
                &#x1F929; Und weil uns deine Zufriedenheit am Herzen liegt, hören wir gerne auf dein
                Feedback und nehmen Verbesserungsvorschläge an, um unseren Service stetig zu
                optimieren.
            </p>

            <p>
                &#x1F355; Wir freuen uns darauf, dich mit unserer Pizza-Kunst zu begeistern!
            </p>

            <p>Dein Delivery Team</p>
        </section>
    </section>

    <!-- cart -->
    <section id="order_box" class="{{#if hideCart}}order_hidden{{/if}}">
    <section id="cart_box">
            {{#if cartTotalItems}}

                <!-- items -->
                {{#each cartItems}}
                    <section class="cart_item">
                        <section class="cart_row">
                            <p class="cart_name">{{name}}</p>
                            <p class="cart_price">{{priceText}}</p>
                        </section>

                        <section class="cart_amount_row">
                            <!-- +\- (change amount) -->
                            <div class="cart_amount_controls">

                                <form method="post" action="/cart/remove">
                                    <input type="hidden" name="productId" value="{{id}}">
                                    <button type="submit" class="cart_btn">−</button>
                                </form>

                                <span class="cart_amount">{{amount}}</span>

                                <form method="post" action="/cart/add">
                                    <input type="hidden" name="productId" value="{{id}}">
                                    <button type="submit" class="cart_btn">+</button>
                                </form>

                            </div>

                            <p class="cart_subtotal">{{subtotalText}}</p>
                        </section>
                    </section>

                    <div class="cart_divider"></div>
                {{/each}}

                <!-- sum -->
                <section class="cart_sum">
                    <section class="cart_row">
                        <p class="cart_name">Summe</p>
                        <p class="cart_price">{{cartTotalEuro}}</p>
                    </section>
                </section>

                <div class="cart_divider"></div>

                <div class="cart_divider"></div>

                <!-- min price -->
                <section class="cart_minimum_row">
                    <p class="cart_minimum_label">Mindestbestellwert</p>
                    <p class="cart_minimum_value">{{minOrder}}</p>
                </section>

                <!-- check min price -->
                {{#if minOrderOk}}
                    <a id="cart_button" href="/bestelluebersicht">
                        <p id="cart_button_left">{{cartTotalItems}} Artikel | {{cartTotalEuro}}</p>
                        <p id="cart_button_right">WEITER</p>
                    </a>
                {{else}}
                    <div id="cart_button_disabled" aria-disabled="true">
                        <p id="cart_button_left">{{cartTotalItems}} Artikel | {{cartTotalEuro}}</p>
                        <p id="cart_button_right">WEITER</p>
                    </div>
                {{/if}}
            {{/if}}


        </section>
    </section>
</section>

<!-- footer -->
<footer id="footer_box">
    <p id="footer_title">KONTAKT</p>

    <section id="footer_text">
        <p>Delivery Pizza</p>
        <p>Römerstr. 37</p>
        <p>93047 Regensburg</p>
    </section>
</footer>

<!-- scripts -->
<script src="/js/main.js"></script>
</body>
</html>
