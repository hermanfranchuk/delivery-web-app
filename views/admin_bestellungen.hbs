<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Delivery – Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<header>
    <!-- header -->
    <nav>
        <a href="/" id="logo">Delivery Admin</a>

        <a href="/admin/bestellungen" id="adm">Alle Bestellungen</a>

        <a href="/produkte?category=pizza" id="menu_nav">Speisekarte</a>
        <a href="/ausloggen" id="ausloggen">Ausloggen</a>
        <span id="hello_user">Hallo {{user.firstname}}</span>
    </nav>
    <!-- errors -->
    <div id="toast_msg"></div>
</header>

<section id="main_part" style="display: flex; flex-direction: column; gap: 24px;">
    <!-- search line -->
    <section class="admin_search_wrapper">
        <form class="admin_search" method="get" action="/admin/bestellungen">
                <input
                        type="text"
                        name="search"
                        placeholder="Kunde suchen…"
                        value="{{search}}"
                >
            <button type="submit">Suchen</button>
        </form>
    </section>

    <!-- manage orders -->
    <section id="admin_orders">
        {{#if orders.length}}

            <!-- orders -->
            {{#each orders}}
                <!-- map -->
                <section class="admin_order_card">
                    <section class="admin_order_map" data-address="{{address}}">
                        <div class="admin_map_placeholder">Map…</div>
                    </section>

                    <section class="admin_order_header">
                        <p class="admin_order_id">Bestellnummer: {{id}}</p>
                        <p class="admin_order_customer">Kunde: {{customerName}}</p>
                    </section>

                    <section class="admin_order_items">
                        <!-- ordered items -->
                        {{#each items}}
                            <div class="admin_order_item">
                                <span>{{quantity}}× {{name}}</span>
                            </div>
                        {{/each}}
                    </section>

                    <!-- green button -->
                    <section class="admin_order_footer">
                        <form method="post" action="/admin/bestellung/erledigt">
                            <input type="hidden" name="orderId" value="{{id}}">
                            <button type="submit" class="admin_done_btn">✔</button>
                        </form>
                    </section>

                </section>
            {{/each}}

        {{else}}
            <p class="admin_empty">Keine offenen Bestellungen</p>
        {{/if}}
    </section>
</section>

<!-- footer -->
<footer id="footer_box">
    <p id="footer_title">KONTAKT</p>

    <section id="footer_text">
        <p>Delivery Pizza</p>
        <p>Römerstr. 37</p>
        <p>93047 Regensburg</p>
    </section>
</footer>

<!-- scripts -->
<script src="/js/main.js"></script>
</body>
</html>
