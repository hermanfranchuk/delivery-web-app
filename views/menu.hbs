<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<!-- header -->
<header>
    <nav>
        <!-- admin check -->
        {{#if isAdmin}}
            <a href="/" id="logo">Delivery Admin</a>
            <a href="/admin/bestellungen" id="adm">Alle Bestellungen</a>
        {{else}}
            <a href="/" id="logo">Delivery</a>
        {{/if}}

        <a href="/ausloggen" id="ausloggen">Ausloggen</a>
        <span id="hello_user">Hello {{user.firstname}}</span>
    </nav>
</header>

<section id="main_part">
    <!-- menu -->
    <section id="menu_section">
        <!-- category dropdown -->
        <form method="get" action="/produkte" class="category_select_form">
            <select name="category"
                    class="category_select"
                    onchange="this.form.submit()">

                {{#each allCategories}}
                    <option value="{{key}}"
                            {{#if selected}}selected{{/if}}>
                        {{title}}
                    </option>
                {{/each}}

            </select>
        </form>

        <!-- items from selected category -->
        <section class="category_box">
            <section class="category_content">
                {{#each products}}
                    <section class="menu_item">
                        <img class="menu_img" src="/{{imageUri}}" alt="{{name}}">

                        <section class="menu_info">
                            <p class="menu_name">{{name}}</p>
                            <p class="menu_price">{{price}}</p>
                            <p class="menu_desc">{{description}}</p>
                        </section>

                        <section class="menu_action">
                            <form method="post" action="/cart/add">
                                <input type="hidden" name="productId" value="{{id}}">
                                <button class="menu_btn" type="submit">Auswählen</button>
                            </form>
                        </section>
                    </section>

                    <div class="menu_divider"></div>
                {{/each}}
            </section>
        </section>
    </section>

    <!-- cart -->
    <section id="order_box">
        <section id="cart_box">

            <!-- items -->
            {{#each cartItems}}
                <section class="cart_item">
                    <section class="cart_row">
                        <p class="cart_name">{{name}}</p>
                        <p class="cart_price">{{priceText}}</p>
                    </section>

                    <section class="cart_amount_row">
                        <!-- +\- (change amount) -->
                        <div class="cart_amount_controls">

                            <form method="post" action="/cart/remove">
                                <input type="hidden" name="productId" value="{{id}}">
                                <button type="submit" class="cart_btn">−</button>
                            </form>

                            <span class="cart_amount">{{amount}}</span>

                            <form method="post" action="/cart/add">
                                <input type="hidden" name="productId" value="{{id}}">
                                <button type="submit" class="cart_btn">+</button>
                            </form>

                        </div>

                        <p class="cart_subtotal">{{subtotalText}}</p>
                    </section>
                </section>

                <div class="cart_divider"></div>
            {{/each}}

            <!-- sum -->
            <section class="cart_sum">
                <section class="cart_row">
                    <p class="cart_name">Summe</p>
                    <p class="cart_price">{{cartTotalEuro}}</p>
                </section>
            </section>

            <div class="cart_divider"></div>

            <!-- min price -->
            <section class="cart_minimum_row">
                <p class="cart_minimum_label">Mindestbestellwert</p>
                <p class="cart_minimum_value">{{minOrder}}</p>
            </section>

            <!-- check min price -->
            {{#if minOrderOk}}
                <a id="cart_button" href="/bestelluebersicht">
                    <p id="cart_button_left">{{cartTotalItems}} Artikel | {{cartTotalEuro}}</p>
                    <p id="cart_button_right">WEITER</p>
                </a>
            {{else}}
                <div id="cart_button_disabled" aria-disabled="true">
                    <p id="cart_button_left">{{cartTotalItems}} Artikel | {{cartTotalEuro}}</p>
                    <p id="cart_button_right">WEITER</p>
                </div>
            {{/if}}
        </section>
    </section>
</section>

<!-- footer -->
<footer id="footer_box">
    <p id="footer_title">KONTAKT</p>

    <section id="footer_text">
        <p>Delivery Pizza</p>
        <p>Römerstr. 37</p>
        <p>93047 Regensburg</p>
    </section>
</footer>

<!-- scripts -->
<script src="/js/main.js"></script>
</body>
</html>
